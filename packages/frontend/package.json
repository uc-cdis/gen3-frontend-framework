{
  "name": "@gen3/frontend",
  "version": "0.12.44",
  "description": "Gen3 frontend components, content management, and pages",
  "keywords": [],
  "author": "Center for Translational Data Science",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "npm": ">=11.9.0",
    "node": ">=24.15.0"
  },
  "main": "dist/index/cjs/index.js",
  "module": "dist/index/esm/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint .",
    "compile": "tsc",
    "clean": "rm -rf dist",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "jest unit",
    "test:watch": "jest unit --watch",
    "test:int": "echo No integrations tests yet",
    "test:all": "jest",
    "types": "tsc --emitDeclarationOnly",
    "copy-tailwind": "cp src/tailwind.cjs dist/tailwind.cjs",
    "build": "npm run compile && npm run types && npm run rollup",
    "build:clean": "npm run clean && npm run build",
    "build:watch": "npm run compile --stream && npm run rollup -- --watch",
    "dev": "echo no dev tasks"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index/cjs/index.js"
      }
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server/esm/server.js",
      "require": "./dist/server/cjs/server.cjs"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages/esm/pages.js",
      "require": "./dist/pages/cjs/pages.cjs"
    },
    "./aiChat": {
      "types": "./dist/aiChat.d.ts",
      "import": "./dist/aiChat/esm/aiChat.js",
      "require": "./dist/aiChat/cjs/aiChat.cjs"
    },
    "./dist/styles.css": "./dist/styles.css"
  },
  "style": "dist/styles.css",
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.156",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@gen3/core": "^0.12.44",
    "@graphiql/react": "^0.37.4",
    "@hello-pangea/dnd": "^18.0.0",
    "@iconify-icon/react": "^3.0.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@next/mdx": "^16.2.7",
    "@reduxjs/toolkit": "^2.5.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.19.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/line-clamp": "^0.4.2",
    "@tailwindcss/typography": "^0.5.7",
    "@theothergothamdev/pluralize-ts": "^1.1.0",
    "binguru": "^1.0.1",
    "cookies-next": "^6.1.0",
    "default-composer": "^0.6.0",
    "echarts": "^6.0.0",
    "fetch-retry": "^5.0.6",
    "file-saver": "^2.0.5",
    "filesize": "^10.1.1",
    "graphiql": "^5.2.3",
    "graphql": "^16.9.0",
    "graphql-ws": "^5.16.2",
    "igv": "^3.7.3",
    "isomorphic-dompurify": "^2.32.0",
    "jose": "^6.1.0",
    "js-cookie": "^3.0.5",
    "json-file-database": "^2.0.3",
    "katex": "^0.16.45",
    "minisearch": "^7.1.2",
    "next-compose-plugins": "^2.2.1",
    "react-minisearch": "^7.1.4",
    "rehype-sanitize": "^6.0.0",
    "streamdown": "^2.5.0",
    "typescript-pluralize": "^1.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "swr": "^2.2.5"
  },
  "peerDependencies": {
    "@mantine/core": "^9.1.0",
    "@mantine/dates": "^9.1.0",
    "@mantine/form": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@mantine/modals": "^9.1.0",
    "@mantine/notifications": "^9.1.0",
    "mantine-react-table-open": "^9.0.3",
    "next": "^16.2.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.18"
  }
}
