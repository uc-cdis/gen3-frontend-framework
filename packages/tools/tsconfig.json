{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./src/buildColors/dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // oxlint's type-aware pass (tsgolint) does not auto-include node_modules/@types
    // the way tsc does; these are all Node CLI scripts.
    "types": ["node", "jest"]
  }
}
