{
  "name": "@gen3/workspaces",
  "version": "0.12.41",
  "description": "Workspaces for Gen3",
  "license": "Apache-2.0",
  "sideEffects": false,
  "author": "Center for Translational Data Science",
  "engines": {
    "npm": ">=11.9.0",
    "node": ">=24.14.0"
  },
  "main": "dist/index/cjs/index.js",
  "module": "dist/index/esm/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint .",
    "compile": "tsc",
    "types": "tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run compile && npm run types && npm run rollup",
    "build:clean": "npm run compile && npm run types && npm run rollup",
    "dev": "echo no dev tasks"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index/cjs/index.js"
      }
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server/esm/server.js",
      "require": "./dist/server/cjs/server.js"
    }
  },
  "dependencies": {
    "@gen3/core": "^0.12.41",
    "@gen3/frontend": "^0.12.41",
    "camelcase-keys": "^10.0.2"
  },
  "peerDependencies": {
    "@mantine/core": "^9.1.0",
    "@mantine/dates": "^9.1.0",
    "@mantine/form": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@mantine/modals": "^9.1.0",
    "@mantine/notifications": "^9.1.0",
    "mantine-react-table-open": "^9.0.3",
    "next": "^15.5.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.18"
  }
}
