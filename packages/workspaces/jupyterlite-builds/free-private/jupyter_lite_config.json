{
  "LiteBuildConfig": {
    "apps": ["lab"],
    "output_dir": "site"
  },
  "LiteServerConfig": {
    "contents": ["./notebooks"],
    "settings_overrides": {
      "@jupyterlite/piplite-extension:plugin": {
        "pipliteDeps": [
          "numpy",
          "pandas",
          "scipy",
          "matplotlib",
          "seaborn",
          "biopython",
          "scanpy",
          "anndata",
          "pysam",
          "boto3",
          "s3fs"
        ]
      }
    }
  }
}
