{
  "LiteBuildConfig": {
    "apps": ["lab"],
    "output_dir": "site"
  },
  "PyodideLockAddon": {
    "enabled": true,
    "wheels": ["pypi/"],
    "specs": [
      "gen3",
      "cdislogging",
      "indexclient",
      "drsclient",
      "fastavro",
      "pyodide-http",
      "pypfb",
      "gen3datamodel"
    ]
  },
  "PyodideLockOfflineAddon": {
    "enabled": true
  },
  "LiteServerConfig": {
    "contents": ["./notebooks"],
    "settings_overrides": {
      "@jupyterlite/piplite-extension:plugin": {
        "pipliteDeps": [
          "numpy",
          "pandas",
          "scipy",
          "matplotlib",
          "seaborn",
          "biopython",
          "scanpy",
          "anndata",
          "pysam",
          "boto3",
          "s3fs"
        ]
      }
    }
  }
}
