{
  "routes": {
    "/Workspace": {
      "loginRequired": true,
      "authz": [
        {
          "resource": "/workspace",
          "service": "jupyterhub",
          "method": "access"
        }
      ],
      "redirect403": "/WorkspaceRequestAccess"
    },
    "/Workspaces": {
      "loginRequired": true,
      "authz": [
        {
          "resource": "/workspace",
          "service": "jupyterhub",
          "method": "read"
        }
      ],
      "redirect403": "/WorkspaceRequestAccess"
    },
    "/WorkspaceRequestAccess": {
      "loginRequired": true,
      "authz": [
        {
          "resource": "/workspace",
          "service": "requestor",
          "method": "create"
        }
      ]
    },
    "/Profile": {
      "loginRequired": true
    },
    "*": {
      "loginRequired": false
    }
  }
}
