{
  "name": "@gen3/samplecommons",
  "version": "0.12.41",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "build": "next build",
    "lint": "next lint",
    "lint-fix": "next lint --fix",
    "predev": "[ -f ../../node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js ] && node ../../node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js || (printf \"\\033[31mError: @gen3/toolsff not built. Please run build in the tools directory first.\\033[0m\\n\" && exit 1)",
    "dev": "next dev --turbopack",
    "devssh": "next dev --port 3010 --experimental-https --experimental-https-key /Users/craigrbarnes/ssl_certs/key.pem --experimental-https-cert /Users/craigrbarnes/ssl_certs/cert.pem ",
    "clean": "rm -rf .next && rm -rf out",
    "prebuild": "node ../../node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js",
    "start": "next start",
    "build:colors": "node ../../node_modules/@gen3/toolsff/dist/buildColors.esm.js --themeFile=config/$npm_config_commons/colors.json --out=config/$npm_config_commons",
    "build:colors:noshift": "node ../../node_modules/@gen3/toolsff/dist/buildColors.esm.js --themeFile=config/$npm_config_commons/colors.json --out=config/$npm_config_commons --colorShift=0 --colorSaturation=100",
    "build:colors:vars": "node ../../node_modules/@gen3/toolsff/dist/buildColors.esm.js --themeFile=config/$npm_config_commons/colors.json --out=config/ --vars",
    "build:icons": "node ../../node_modules/@gen3/toolsff/dist/bundleIcons.esm.js --inpath=config/icons --outpath=config/icons",
    "getSchema": "node ../../node_modules/@gen3/toolsff/dist/getSchema.esm.js --out=config/",
    "getDRSToHostname": "node ../../node_modules/@gen3/toolsff/dist/getDRSToHostname.esm.js --out=config/",
    "build:middlewarePaths": "node ../../node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js",
    "build:middlewarePathsMatchAll": "node ../../node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js --forceMatchAll",
    "build:clean": "npm run clean && npm run build"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.0.19",
    "@fontsource/poppins": "^5.0.15",
    "@fontsource/source-sans-pro": "^5.0.8",
    "@gen3/core": "file:../core",
    "@gen3/frontend": "file:../frontend",
    "@gen3/workspaces": "file:../workspaces",
    "@gen3/jupyter-workspaces": "file:../../../gen3-workspace-apps/packages/jupyter-workspaces",
    "@mantine/core": "^9.1.0",
    "@mantine/dates": "^9.1.0",
    "@mantine/form": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@mantine/modals": "^9.1.0",
    "@mantine/notifications": "^9.1.0",
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^15.5.10",
    "file-saver": "^2.0.5",
    "file-system-db": "^2.1.0",
    "jose": "^6.1.0",
    "jsonpath-plus": "^10.3.0",
    "mantine-react-table-open": "^9.0.3",
    "next": "^15.5.16",
    "pluralize": "^8.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-minisearch": "^7.1.4",
