    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.3.3"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
