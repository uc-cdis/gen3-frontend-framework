{
  "name": "gen3-frontend-framework",
  "version": "0.12.34",
  "description": "The Gen3 Frontend Framework mono repo for Gen 3.2 development",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/frontend",
    "packages/storybook",
    "packages/tools",
    "packages/sampleCommons"
  ],
  "engines": {
    "npm": ">=11.9.0",
    "node": ">=24.14.0"
  },
  "scripts": {
    "lint": "lerna run lint",
    "lint-fix": "eslint . --fix",
    "lint:config": "npx @eslint/config-inspector@latest",
    "oxlint": "oxlint .",
    "analyze": "lerna run analyze --scope=@gen3/samplecommons",
    "build:tools": "lerna run build --scope=@gen3/toolsff --stream",
    "build": "lerna run build",
    "build:pkg": "lerna run build --include-dependencies --stream --ignore=@gen3/samplecommons",
    "build:clean": "lerna run build:clean",
    "compile": "lerna run compile",
    "predev": "if [ ! -f ./node_modules/@gen3/toolsff/dist/scanSitePaths.esm.js ]; then printf \"\\033[31mError: @gen3/toolsff not built (missing dist file). Run: npm run build:tools\\033[0m\\n\"; exit 1; fi",
    "dev": "NODE_OPTIONS='--max_old_space_size=4096' lerna run dev",
    "dev:watch": "lerna watch -- lerna run dev --scope=\\$LERNA_PACKAGE_NAME --include-dependencies",
    "dev:app": "lerna run dev --scope=@gen3/samplecommons",
    "dev:build": "lerna run build --scope=@gen3/core --scope=@gen3/frontend --stream",
    "dev:watch:pkgs": "lerna watch --scope=@gen3/core --scope=@gen3/frontend -- lerna run build --scope=\\$LERNA_PACKAGE_NAME",
    "dev:full": "npm run dev:build && npm run dev:app",
    "start": "lerna run start",
    "storybook": "lerna run storybook --scope=@gen3/storybook",
    "build:start": "npm run build && npm run start",
    "setProxy": "(cd ./packages/tools/localDev/nginx/; ./configureNginx.sh -d $npm_config_domain)",
    "test": "npm run test --workspaces",
    "test:int": "npm run test:int --workspaces",
    "test:all": "npm run test:all --workspaces"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@grafana/faro-react": "^1.9.1",
    "@grafana/faro-web-sdk": "^1.9.1",
    "@grafana/faro-web-tracing": "^1.9.1",
    "@next/bundle-analyzer": "^15.5.9",
    "classnames": "^2.3.1",
    "dayjs": "^1.11.19",
    "glob": "^10.5.0",
    "idb": "^8.0.3",
    "isomorphic-fetch": "^3.0.0",
    "jsonpath-plus": "10.3.0",
    "react": "^19.2.4",
    "react-cookie": "^7.2.2",
    "react-dom": "^19.2.4",
    "react-responsive-carousel": "^3.2.23",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.0",
    "@eslint/js": "^9.28.0",
    "@next/eslint-plugin-next": "^15.5.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@storybook/nextjs": "10.3.6",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.7.28",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.13",
    "@types/node": "22.7.2",
    "@types/react": "^19.2.14",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@welldone-software/why-did-you-render": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.9",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "10.3.6",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "lerna": "^9.0.3",
    "msw": "^2.7.3",
    "nx": "22.3.3",
    "oxlint": "^1.59.0",
    "postcss-import": "^16.1.0",
    "postcss-modules": "^6.0.0",
    "postcss-preset-mantine": "^1.17.0",
    "prettier": "^3.6.2",
    "rollup": "^4.22.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "rollup-plugin-swc3": "^0.11.2",
    "rollup-swc-preserve-directives": "^0.7.0",
    "tailwindcss": "^3.4.18",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.2.5",
    "ts-json-schema-generator": "^2.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.26.0"
  },
  "overrides": {
    "rollup-plugin-copy": {
      "globby": "^11.0.0"
    },
    "tailwindcss": {
      "sucrase": {
        "glob": "^13.0.6"
      }
    },
    "mantine-react-table": {
      "@mantine/core": "^9.1.0",
      "@mantine/hooks": "^9.1.0",
      "@mantine/dates": "^9.1.0",
      "@mantine/form": "^9.1.0",
      "@mantine/modals": "^9.1.0",
      "@mantine/notifications": "^9.1.0"
    }
  },
  "optionalDependencies": {
    "@nx/nx-darwin-arm64": "^20.7.1",
    "@nx/nx-linux-arm64-gnu": "^20.7.1",
    "@nx/nx-linux-x64-gnu": "^20.7.1",
    "@swc/core-linux-x64-gnu": "^1.11.10",
    "@swc/nx-darwin-arm64": "^1.11.10",
    "@swc/nx-linux-arm64-gnu": "^1.11.10"
  }
}
